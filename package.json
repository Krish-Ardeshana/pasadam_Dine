{
  "name": "prasadam-dine-monorepo",
  "version": "1.0.0",
  "description": "PRASADAM DINE - AR Smart Restaurant Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:db": "npm --prefix backend run db",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test:backend": "npm --prefix backend run test",
    "test": "npm run test:backend"
  },
  "keywords": [
    "restaurant",
    "augmented-reality",
    "nestjs",
    "nextjs",
    "mongodb",
    "razorpay"
  ],
  "author": "Prasadam Dine Team",
  "license": "UNLICENSED"
}
