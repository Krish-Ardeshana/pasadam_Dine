# ==============================================================================
# PRASADAM DINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and configure values for your environment.
# DO NOT COMMIT PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_BASE_URL=http://localhost:3000
# Comma-delimited list of allowed frontend origins (e.g. for Vercel and custom domains)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://prasadam-dine.vercel.app

# MongoDB Atlas / Local Connection URI
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/prasadam_dine?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/prasadam_dine
MONGODB_URI=mongodb://127.0.0.1:27017/prasadam_dine

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_256_bit_random_string_for_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_this_with_a_different_secure_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Bootstrap (Idempotent seed on first startup)
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL=admin@prasadamdine.com
SUPER_ADMIN_PASSWORD=ChangeMeInProduction2026!

# Cloudinary Storage (Required for Production Media Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=prasadam_dine

# Media Storage Driver ('local' for offline development fallback, 'cloudinary' for production)
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
